// Shared build settings for every target (spec 016 §5, spec 005 §9).
#include "Identity.xcconfig"

// Swift 6 language mode, strict concurrency
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// macOS 14 or newer, Apple Silicon only
MACOSX_DEPLOYMENT_TARGET = 14.0
ARCHS = arm64
EXCLUDED_ARCHS = x86_64
SDKROOT = macosx

// Signing: Personal Team "Apple Development", hardened runtime, no sandbox.
// Never "Sign to Run Locally" (ad hoc): launchd refuses to start the helper (spike 009).
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Development
PROVISIONING_PROFILE_SPECIFIER =
ENABLE_HARDENED_RUNTIME = YES
// Release builds must not be debuggable: with get-task-allow any process running as John could
// attach to the app and use its Full Disk Access and helper connection. Xcode adds it to
// development-signed builds unless told not to; Debug keeps it so Xcode can still debug.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO
ENABLE_APP_SANDBOX = NO

// Version 1.0; CFBundleVersion is the integer build number = rule-set version (build spec §1)
MARKETING_VERSION = 1.0.3
CURRENT_PROJECT_VERSION = 4
